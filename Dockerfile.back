# syntax=docker/dockerfile:1
#
# Image du backend. À construire depuis la racine du dépôt, où se trouve ce
# fichier : `docker build -f Dockerfile.back .` (Dokploy : Build Path `/`,
# Docker File `Dockerfile.back`). Le bun.lock y est, commun aux trois
# workspaces : l'installation le suit à la lettre (--frozen-lockfile) au lieu
# de résoudre les versions à chaque build.
#
# Les couches sont rangées de la moins à la plus changeante : tant que les
# package.json et bun.lock ne bougent pas, l'installation vient du cache, et
# tant que le schéma Prisma ne bouge pas, le client généré aussi. Un commit
# qui ne touche que src/ ne refait que la dernière copie.

# --- Dépendances de production du backend seul ---
FROM oven/bun:1.4 AS deps
WORKDIR /app

# Tous les package.json des workspaces : sans eux, bun considère que le
# lockfile ne correspond plus et refuse l'installation figée.
COPY package.json bun.lock ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
COPY mcp-server/package.json mcp-server/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production --filter @humanitour/backend

# --- Client Prisma (ne se régénère que si le schéma change) ---
FROM deps AS runner
WORKDIR /app/backend

COPY backend/prisma.config.ts ./
COPY backend/prisma ./prisma
RUN --mount=type=cache,target=/root/.cache bunx prisma generate

# --- Code : la seule couche refaite à chaque commit ---
COPY backend/tsconfig.json ./
COPY backend/src ./src

ENV NODE_ENV=production
ENV PORT=3535
# Chemin absolu : le dossier de travail est /app/backend, et le défaut
# relatif (./uploads) sortirait du volume monté sur /app/uploads.
ENV UPLOAD_DIR=/app/uploads
EXPOSE 3535

# Migrations appliquées à chaque démarrage, par l'image elle-même : Dokploy
# (type Dockerfile) ne lit pas la `command` d'un docker-compose.
CMD ["sh", "-c", "bunx prisma migrate deploy && exec bun run src/index.ts"]
