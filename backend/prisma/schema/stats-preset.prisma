/// Configuration de croisement/filtres enregistrée par un utilisateur depuis
/// la page Statistiques (voir frontend/src/routes/admin/forms/[id]/stats).
model StatsPreset {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  name   String

  /// Formulaires concernés (1 = croisement simple, 2+ = comparaison
  /// inter-formulaires). Stocké en Json, comme `Form.allowedEmails`, pour
  /// rester compatible MySQL (pas de String[] scalaire Postgres).
  formIds Json @default("[]")

  /// { rowFields, colFields, crossMode, extraFilters, numericFilters,
  ///   dateStart?, dateEnd? }- voir la page Statistiques pour la forme exacte.
  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
