/// Rôles applicatifs (cercle 3 : administration de la plateforme OpenForms).
/// - SUPER_ADMIN : gestion des comptes, des clés d'API et de l'app elle-même.
/// - EDITOR      : compte standard- ses droits sur un formulaire donné dépendent
///                 uniquement de FormAccess (cercle 1), jamais de ce rôle.
enum Role {
  SUPER_ADMIN
  EDITOR
}

/// Rôle d'un collaborateur sur un formulaire donné (cercle 1, à la Google Forms).
/// - VIEWER    : consultation du formulaire, des réponses et des commentaires.
/// - COMMENTER : idem VIEWER + peut laisser des commentaires.
/// - EDITOR    : droits complets (structure, réglages, réponses, suppression).
enum FormRole {
  VIEWER
  COMMENTER
  EDITOR
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  /// Hash Argon2id calculé via Bun.password- jamais le mot de passe en clair.
  /// `null` tant que le titulaire n'a pas défini son mot de passe via le lien d'invitation.
  passwordHash String?
  role         Role         @default(EDITOR)
  displayName  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions            Session[]
  ownedForms          Form[]               @relation("FormOwner")
  formAccess          FormAccess[]
  organizations       OrganizationMember[]
  passwordSetupTokens PasswordSetupToken[]
  statsPresets        StatsPreset[]
  apiKeys             ApiKey[]
  comments            Comment[]
  formVersions        FormVersion[]

  @@index([email])
}

/// Clé d'API personnelle : permet à un client externe (serveur MCP, script)
/// d'agir au nom de l'utilisateur via l'en-tête `Authorization: Bearer <token>`.
/// Les droits restent ceux du compte porteur- aucune élévation de privilège.
model ApiKey {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  name   String
  /// SHA-256 du token remis à la création- jamais stocké en clair.
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Jeton à usage unique envoyé par email permettant de définir (ou
/// réinitialiser) le mot de passe d'un compte créé sans mot de passe.
model PasswordSetupToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// SHA-256 du jeton envoyé dans le lien- jamais stocké en clair.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Session serveur : le cookie HttpOnly contient uniquement un identifiant
/// opaque dont le hash est stocké ici (aucun secret exploitable côté client).
model Session {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// SHA-256 du token de session envoyé dans le cookie.
  tokenHash  String   @unique
  /// Secret utilisé pour le jeton anti-CSRF (double-submit).
  csrfSecret String
  userAgent  String?
  ipHash     String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Attribution explicite d'un formulaire à un collaborateur, avec un rôle
/// (cercle 1). L'appartenance à une organisation (cercle 2) ne donne par
/// elle-même aucun droit sur un formulaire précis- voir resolveFormPermission.
model FormAccess {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  role      FormRole @default(VIEWER)
  createdAt DateTime @default(now())

  @@unique([userId, formId])
  @@index([formId])
}

/// Commentaire laissé par un collaborateur sur un formulaire (rôle COMMENTER
/// ou EDITOR). Fil plat, sans réponses imbriquées- `resolved` permet de
/// marquer un point traité, à la manière d'un commentaire Google Docs.
model Comment {
  id        String   @id @default(uuid())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId])
}
